<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_widget_container"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_small_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_widget_scan"
        android:contentDescription="Scan" />

    <TextView
        android:id="@+id/widget_small_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Scan"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_small_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Qobley"
        android:textColor="#94A3B8"
        android:textSize="11sp" />
</LinearLayout>
